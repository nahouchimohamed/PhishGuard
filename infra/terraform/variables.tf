# Defaults target LocalStack. Override aws_endpoint only if you know what you are doing.
# This project never applies Terraform against real AWS in CI or Compose.

variable "aws_region" {
  type        = string
  default     = "us-east-1"
  description = "AWS region string passed to the LocalStack-backed provider (not a real AWS deploy)."
}

variable "aws_endpoint" {
  type        = string
  default     = "http://localhost:4566"
  description = "LocalStack endpoint. Leave as-is for the free local Lambda lesson."
}

variable "database_url" {
  type        = string
  default     = "postgres://phishguard:phishguard@host.docker.internal:5432/phishguard?sslmode=disable"
  description = "Postgres URL the LocalStack Lambda uses to reach Compose Postgres on the host."
}

variable "redis_url" {
  type        = string
  default     = "redis://host.docker.internal:6379/0"
  description = "Redis URL the LocalStack Lambda uses to reach Compose Redis on the host."
}

variable "public_app_url" {
  type        = string
  default     = "http://localhost:5173"
  description = "Public web origin embedded in simulation links generated by the Lambda."
}
