# Web image — SvelteKit BFF that talks to the Go API inside Compose.
FROM node:26-alpine AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build
RUN npm prune --omit=dev

FROM node:26-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
RUN adduser -D -u 10001 appuser
COPY --from=build /app/build ./build
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
USER appuser
EXPOSE 3000
# HEALTHCHECK is defined in deploy/docker-compose.yml (node HTTP probe).
CMD ["node", "build"]
