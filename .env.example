# Shared app settings (copy to .env for local overrides)
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=phishguard
POSTGRES_DB=phishguard
DATABASE_URL=postgres://phishguard:phishguard@postgres:5432/phishguard?sslmode=disable

REDIS_URL=redis://redis:6379/0

# ElasticMQ (SQS-compatible). Path-style URLs match ElasticMQ defaults.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=x
AWS_SECRET_ACCESS_KEY=x
SQS_ENDPOINT=http://elasticmq:9324
SQS_QUEUE_URL=http://elasticmq:9324/queue/phishguard-deliveries
SQS_QUEUE_NAME=phishguard-deliveries

# Public URL used inside simulation links shown to employees
PUBLIC_APP_URL=http://localhost:5173

# Dev seed login (all seeded users share this password)
SEED_PASSWORD=phishguard-dev

# Session cookie
SESSION_COOKIE_NAME=phishguard_session
SESSION_TTL_HOURS=168

# Optional LocalStack (Lambda lesson only — not required for docker compose)
LOCALSTACK_AUTH_TOKEN=
AWS_ENDPOINT_URL=http://localhost:4566
